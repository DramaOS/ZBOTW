import { useState } from "react";
import { Calendar } from "react-calendar";
import "react-calendar/dist/Calendar.css";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

export default function BookingApp() {
  const [date, setDate] = useState(new Date());
  const [selectedSlots, setSelectedSlots] = useState([]);
  const [bookings, setBookings] = useState([]);
  const [name, setName] = useState("");
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  
  const generateTimeSlots = () => {
    const slots = [];
    for (let hour = 8; hour < 22; hour++) {
      slots.push(`${hour.toString().padStart(2, '0')}:00`);
    }
    return slots;
  };

  const availableSlots = generateTimeSlots();
  
  const isSlotBooked = (slot) => {
    return bookings.some(
      (booking) => booking.date.toDateString() === date.toDateString() && booking.slot === slot
    );
  };
  
  const getBookingsForDate = () => {
    return bookings.filter((booking) => booking.date.toDateString() === date.toDateString());
  };
  
  const handleBooking = () => {
    if (!name) return alert("Please enter your name");
    if (selectedSlots.length === 0) return alert("Please select at least one time slot");
    
    const newBookings = selectedSlots.map(slot => ({ name, date, slot }));
    setBookings([...bookings, ...newBookings]);
    alert(`${name} booked for ${date.toDateString()} at ${selectedSlots.join(", ")}`);
    setSelectedSlots([]);
    setName("");
  };

  const handleLogin = () => {
    if (username === "admin" && password === "password") {
      setIsAuthenticated(true);
    } else {
      alert("Invalid credentials");
    }
  };
  
  if (!isAuthenticated) {
    return (
      <div className="flex flex-col items-center justify-center min-h-screen bg-gray-100">
        <div className="bg-white p-6 rounded-lg shadow-lg w-96 text-gray-900">
          <h1 className="text-2xl font-bold text-center mb-4 text-purple-500">Login</h1>
          <Input 
            type="text" 
            placeholder="Username" 
            value={username} 
            onChange={(e) => setUsername(e.target.value)}
            className="mb-2 p-2 border rounded w-full bg-gray-200 text-gray-900"
          />
          <Input 
            type="password" 
            placeholder="Password" 
            value={password} 
            onChange={(e) => setPassword(e.target.value)}
            className="mb-4 p-2 border rounded w-full bg-gray-200 text-gray-900"
          />
          <Button onClick={handleLogin} className="bg-purple-500 text-white w-full py-2 rounded-md hover:bg-purple-600 transition">
            Login
          </Button>
        </div>
      </div>
    );
  }
  
  return (
    <div className="flex flex-col items-center justify-center min-h-screen bg-gray-100 p-6 text-gray-900">
      <div className="bg-white p-6 rounded-lg shadow-lg w-full max-w-lg">
        <h1 className="text-3xl font-bold text-center mb-4 text-purple-500">Book a Time Slot</h1>
        <Input 
          type="text" 
          placeholder="Enter your name" 
          value={name} 
          onChange={(e) => setName(e.target.value)}
          className="mb-4 p-3 border rounded w-full bg-gray-200 text-gray-900"
        />
        <Calendar 
          onChange={setDate} 
          value={date} 
          className="bg-white text-gray-900 border border-gray-300 p-4 rounded-lg"
        />
        <h2 className="text-xl font-semibold mt-4 text-purple-500">Select Time Slots</h2>
        <div className="grid grid-cols-4 gap-2 mt-2">
          {availableSlots.map((slot) => (
            <Button 
              key={slot} 
              onClick={() => setSelectedSlots(prev => 
                prev.includes(slot) ? prev.filter(s => s !== slot) : [...prev, slot]
              )} 
              disabled={isSlotBooked(slot)}
              className={`py-2 px-4 rounded-md ${selectedSlots.includes(slot) ? 'bg-purple-500 text-white' : 'bg-gray-200 text-gray-900'} ${isSlotBooked(slot) ? 'opacity-50 cursor-not-allowed' : 'hover:bg-purple-400'}`}
            >
              {slot}
            </Button>
          ))}
        </div>
        <h2 className="text-xl font-semibold mt-4 text-purple-500">Bookings for {date.toDateString()}</h2>
        <ul className="mt-2 text-gray-900">
          {getBookingsForDate().length > 0 ? (
            getBookingsForDate().map((booking, index) => (
              <li key={index} className="bg-gray-200 p-2 rounded-md mb-1">
                {booking.name} booked {booking.slot}
              </li>
            ))
          ) : (
            <li className="text-gray-500">No bookings for this day.</li>
          )}
        </ul>
        <Button onClick={handleBooking} className="mt-4 bg-purple-500 text-white w-full py-3 rounded-md text-lg hover:bg-purple-600 transition">
          Confirm Booking
        </Button>
      </div>
    </div>
  );
}
